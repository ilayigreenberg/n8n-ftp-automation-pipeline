{
  "name": "restaurant-pipeline",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet places = [];\n\n// in case the information arrives split or as a single list\nif (items.length === 1 && items[0].json.local_results) {\n  places = items[0].json.local_results;\n} else {\n  places = items.map(item => item.json);\n}\n\n// --- start\n\n// takes top 10 places and normalizes\nconst restaurants = places.slice(0, 10).map(place => {\n\n  const days = [\"Sunday\", \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\"];\n\n  const working_hours = place.operating_hours ? days.reduce((obj, day) => {\n    if (place.operating_hours[day.toLowerCase()]) {\n      obj[day] = place.operating_hours[day.toLowerCase()];\n    }\n    return obj;\n  }, {}) : null;\n  \n  return {\n    \"Name\": place.title,\n    \"Address\": place.address,\n    \"Phone\": place.phone || \"N/A\",\n    \"Working Hours\": working_hours\n  };\n});\n\n\nreturn [{ json: {restaurants}}];"
      },
